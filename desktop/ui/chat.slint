// OffconAI Desktop — Chat transcript, calm empty state, and composer.

import { ScrollView } from "std-widgets.slint";
import { ChatTurn, Ui } from "theme.slint";
import { Card, FlatButton, Glyph, SectionLabel, StatusDot } from "widgets.slint";

component ChatTurnView inherits VerticalLayout {
    in property <ChatTurn> turn;

    property <bool> is-user: turn.kind == 0;
    property <bool> is-reasoning: turn.kind == 2;
    property <bool> is-tool: turn.kind == 3;
    property <bool> is-error: turn.kind == 4;
    property <length> body-size: is-reasoning ? 12px : is-tool ? 11px : 14px;
    property <length> body-indent: (is-reasoning || is-tool) ? 12px : 0px;

    width: 100%;
    spacing: 3px;

    Text {
        width: 100%;
        text: turn.role;
        font-size: 11px;
        font-family: is-tool ? Ui.font-mono : Ui.font-sans;
        color: is-error ? Ui.error : Ui.muted;
        horizontal-alignment: is-user ? right : left;
    }

    Text {
        width: parent.width - body-indent;
        x: body-indent;
        text: turn.body;
        wrap: TextWrap.word-wrap;
        font-size: body-size;
        font-family: is-tool ? Ui.font-mono : Ui.font-sans;
        color: is-error ? Ui.error : (is-tool || is-reasoning) ? Ui.muted : Ui.text;
        horizontal-alignment: is-user ? right : left;
        line-height-factor: 1.4;
    }
}

component Transcript inherits Rectangle {
    in property <[ChatTurn]> turns;
    in property <int> scroll-tick;

    property <bool> pinned: true;
    property <bool> scroll-pending: false;
    background: transparent;

    scroll := ScrollView {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

        scrolled => {
            root.pinned = scroll.content-y <= scroll.visible-height - scroll.content-height + 8px;
        }

        VerticalLayout {
            width: scroll.visible-width;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 16px;

            for turn in root.turns : ChatTurnView {
                turn: turn;
            }
        }
    }

    changed scroll-tick => {
        root.scroll-pending = true;
    }

    Timer {
        interval: 16ms;
        running: root.scroll-pending;
        triggered => {
            root.scroll-pending = false;
            if (root.pinned) {
                scroll.content-y = min(0px, scroll.visible-height - scroll.content-height);
            }
        }
    }
}

export component ChatWorkspace inherits VerticalLayout {
    in property <[ChatTurn]> turns;
    in property <int> scroll-tick;
    in property <string> model-indicator;
    in property <string> endpoint-name;
    in property <string> empty-engine;
    in property <bool> model-loaded;
    in property <bool> busy;
    in-out property <string> input-text;

    callback send-requested();
    callback stop-requested();

    spacing: 8px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    // Instrument readout header above the transcript card.
    HorizontalLayout {
        height: 18px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 6px;
            height: 18px;
            background: transparent;
            StatusDot {
                y: 6px;
                active: root.model-loaded;
            }
        }
        Text {
            text: root.model-indicator;
            font-size: 11px;
            font-family: Ui.font-mono;
            color: Ui.muted;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Text {
            text: root.endpoint-name;
            font-size: 11px;
            font-family: Ui.font-mono;
            color: Ui.muted;
            vertical-alignment: center;
        }
    }

    Card {
        horizontal-stretch: 1;
        vertical-stretch: 1;

        if root.turns.length == 0 : VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 32px;
            spacing: 0;
            alignment: start;

            Glyph { glyph-size: 26px; }
            Rectangle { height: 16px; background: transparent; }
            Text {
                text: "No conversation";
                font-size: 16px;
                font-weight: 500;
                color: Ui.text;
            }
            Rectangle { height: 6px; background: transparent; }
            Text {
                text: "Connect a local llama.cpp process or an OpenAI-compatible runtime, then send a prompt.";
                font-size: 12px;
                color: Ui.muted;
            }
            Rectangle { height: 22px; background: transparent; }
            Rectangle {
                width: 340px;
                height: 70px;
                background: Ui.raised;
                border-radius: 10px;
                border-width: 1px;
                border-color: Ui.hairline;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Rectangle {
                            width: 6px;
                            height: 14px;
                            background: transparent;
                            StatusDot {
                                y: 4px;
                                active: root.model-loaded;
                            }
                        }
                        SectionLabel { text: "Engine"; }
                    }
                    Text {
                        text: root.empty-engine;
                        font-size: 11px;
                        font-family: Ui.font-mono;
                        color: Ui.text;
                        overflow: elide;
                    }
                }
            }
        }

        Transcript {
            width: 100%;
            height: 100%;
            visible: root.turns.length > 0;
            turns: root.turns;
            scroll-tick: root.scroll-tick;
        }
    }

    // Flat surface composer with 72px text well + action strip.
    Rectangle {
        height: 96px;
        background: Ui.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: composer-input.has-focus ? Ui.accent : Ui.hairline;

        composer-input := TextInput {
            x: 14px;
            y: 10px;
            width: parent.width - 28px;
            height: 52px;
            text <=> root.input-text;
            single-line: false;
            wrap: TextWrap.word-wrap;
            font-size: 14px;
            font-family: Ui.font-sans;
            color: Ui.text;
            enabled: !root.busy;
            selection-background-color: Ui.accent;
            selection-foreground-color: #FFFFFF;
            key-pressed(event) => {
                if (event.text == "\n" && !event.modifiers.shift) {
                    root.send-requested();
                    return accept;
                }
                return reject;
            }
        }

        Text {
            x: 15px;
            y: 10px;
            width: parent.width - 30px;
            height: 22px;
            text: root.input-text == "" ? "Write a prompt..." : "";
            font-size: 14px;
            color: Ui.muted;
            vertical-alignment: center;
        }

        HorizontalLayout {
            x: 14px;
            y: parent.height - 34px;
            width: parent.width - 28px;
            height: 26px;
            spacing: 8px;
            alignment: end;

            Text {
                text: "Enter sends \u{00B7} Shift+Enter new line";
                font-size: 11px;
                color: Ui.muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }

            if root.busy : FlatButton {
                label: "Stop";
                button-enabled: true;
                height: 26px;
                clicked => { root.stop-requested(); }
            }
            FlatButton {
                label: "Send";
                primary: true;
                button-enabled: !root.busy;
                height: 26px;
                clicked => { root.send-requested(); }
            }
        }
    }
}
